# =============================================================================
# Example Terraform variables — copy to terraform.tfvars and edit.
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars is git-ignored so your values stay local.
# =============================================================================

aws_region   = "us-east-1"
project_name = "maminco"
environment  = "prod"

# --- Compute (cheap defaults) ------------------------------------------------
# t4g.small  -> ARM/Graviton, ~$12/mo  (keep instance_architecture = "arm64")
# t3.micro   -> x86_64, free-tier eligible (set instance_architecture = "x86_64")
instance_type          = "t4g.small"
instance_architecture  = "arm64"
root_volume_size       = 20

# --- Data + backups ----------------------------------------------------------
data_volume_size      = 20
backup_retention_days = 7
swap_size_mb          = 1024

# --- Access ------------------------------------------------------------------
# Existing EC2 key pair. Leave commented to use SSM Session Manager only.
# key_name         = "my-ec2-key"

# SSH is closed unless you set this to your own IP (0.0.0.0/0 is rejected).
# Preferred: leave it commented and use SSM Session Manager (see outputs).
# allowed_ssh_cidr = "198.51.100.7/32"

enable_elastic_ip = true

# --- Repositories to clone at first boot -------------------------------------
repo_base_url = "https://github.com/ThonkasM"
git_branch    = "main"

# --- Optional static CDN (leave off: the frontend needs a Node server) --------
enable_static_cdn     = false
cloudfront_price_class = "PriceClass_100"

# --- Public domain: Route 53 + CloudFront in front of the host ------------------
# 1) Register maminco.lat. 2) First apply with enable_cdn_and_dns = true creates the
# hosted zone; copy `name_servers` to the registrar; the ACM validation waits until
# the delegation propagates (see docs/DEPLOYMENT.md §11).
enable_cdn_and_dns = false
domain_name        = "maminco.lat"
create_hosted_zone = true
# hosted_zone_id   = "Z0123456789ABC"   # only when create_hosted_zone = false
# openssl rand -hex 32 (same value as ORIGIN_VERIFY_SECRET in the host .env)
# origin_verify_secret = "change-me-32-chars-or-more"
