# Remote state (recommended once more than one person runs terraform).
#   1. Create the bucket once, outside this configuration:
#        aws s3api create-bucket --bucket <unique-name> --region us-east-1
#        aws s3api put-bucket-versioning --bucket <unique-name> --versioning-configuration Status=Enabled
#        aws s3api put-bucket-encryption --bucket <unique-name> \
#          --server-side-encryption-configuration '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'
#        aws s3api put-public-access-block --bucket <unique-name> \
#          --public-access-block-configuration BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
#   2. cp backend.tf.example backend.tf, edit the bucket, then: terraform init -migrate-state
# Locking: use_lockfile needs Terraform >= 1.10 (S3 native lock file). On older
# versions replace it with: dynamodb_table = "<table with LockID string key>".
terraform {
  backend "s3" {
    bucket       = "<unique-name>"
    key          = "maminco-infra/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
