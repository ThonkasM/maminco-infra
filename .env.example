# =============================================================================
# Maminco infra — environment template (copy to .env, which is git-ignored)
#   cp .env.example .env
#
# Secrets are intentionally EMPTY and have no fallback: `docker compose` aborts
# until every one of them is set. Generate each with:
#   openssl rand -hex 32
# Use hex values (no special characters): they are embedded in connection URLs.
# Never reuse one value for two secrets.
# =============================================================================

# --- Secrets (required) ------------------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
# Shared backend <-> AI token. Compose passes it to the AI service as
# AI_INTERNAL_SERVICE_TOKEN, so there is only one value to set. >= 32 chars.
INTERNAL_SERVICE_TOKEN=
# Password of the read-only `maminco_ai` Postgres role used by the AI service.
AI_DB_PASSWORD=

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=maminco
POSTGRES_DB=maminco

# --- Public URLs (required; origins only, no trailing slash, no /api) ---------
# NEXT_PUBLIC_* are compiled into the browser bundle at BUILD time: changing
# them requires `docker compose build frontend`.
# Production (TLS):  https://pos.example.com     Local dev: http://localhost
CORS_ORIGIN=http://localhost
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SOCKET_URL=http://localhost
NEXT_PUBLIC_SITE_URL=http://localhost

# --- TLS / nginx -------------------------------------------------------------
# Host name served by nginx and used for the Let's Encrypt certificate paths.
# Only needed for the TLS site (default). See docs/DEPLOYMENT.md.
DOMAIN=localhost
# Behind CloudFront: DOMAIN=origin.maminco.lat and set the same secret as terraform's origin_verify_secret.
# nginx (443) answers 403 to requests without the matching X-Origin-Verify header.
# Empty = no verification (default; the map then matches only an empty header, so set it when using CloudFront).
ORIGIN_VERIFY_SECRET=
# HTTP-only mode for development: either use `make up-dev`, or set
#   NGINX_TEMPLATE=./nginx/templates/http.conf.template
# NGINX_TEMPLATE=./nginx/templates/https.conf.template

# --- Optional ----------------------------------------------------------------
JWT_EXPIRES_IN=7d
# Business time zone: used for backend reports and AI day/hour bucketing.
REPORT_TIMEZONE=America/La_Paz
# AI_TIMEZONE=America/La_Paz
# AI_LOG_LEVEL=INFO
# Set to true ONLY for the first deploy of a throwaway/demo environment: the
# seed creates well-known test users with weak passwords.
SEED=false
STORAGE_DRIVER=local
ASSETS_BASE_URL=
S3_BUCKET=
S3_REGION=us-east-1
LLM_PROVIDERS=
OPENCODE_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
