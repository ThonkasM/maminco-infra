# =============================================================================
# Maminco infra — shared environment template
# =============================================================================
# Copy to .env (git-ignored) and edit:  cp .env.example .env
#
# INVARIANT: backend `INTERNAL_SERVICE_TOKEN` MUST equal the AI service token.
# In docker-compose the AI side is derived from the same variable, so you only
# set INTERNAL_SERVICE_TOKEN once. Keep them equal if you override elsewhere.
# =============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL container
# ----------------------------------------------------------------------------
POSTGRES_USER=maminco
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=maminco
# Compose builds DATABASE_URL / AI_DATABASE_URL from the values above; you do
# NOT need to set them here (they are overridden in docker-compose.yml to point
# at the `postgres` service hostname).

# ----------------------------------------------------------------------------
# Backend (maminco-backend) — NestJS, port 3000 (internal)
# ----------------------------------------------------------------------------
# REQUIRED, min 32 chars. The app refuses to boot without it.
# Generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated allowed browser origins. With nginx in front use the public
# URL, e.g. http://ec2-1-2-3-4.compute.amazonaws.com or https://pos.example.com
CORS_ORIGIN=http://localhost

# Shared secret backend <-> AI. Also reused as AI_INTERNAL_SERVICE_TOKEN below.
# Generate with:  openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-with-a-shared-service-token

# Where the backend reaches the AI service. Overridden to http://ai:8000 in
# compose; set here for running the backend outside Docker (e.g. local dev).
AI_SERVICE_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# AI (maminco-ai) — FastAPI, port 8000 (internal)
# ----------------------------------------------------------------------------
# AI_INTERNAL_SERVICE_TOKEN MUST equal backend INTERNAL_SERVICE_TOKEN.
# Compose derives it automatically from INTERNAL_SERVICE_TOKEN. Only set this
# if you run the AI service outside compose.
AI_INTERNAL_SERVICE_TOKEN=replace-with-a-shared-service-token

# ----------------------------------------------------------------------------
# Frontend (maminco-frontend) — Next.js, port 3001 (internal)
# ----------------------------------------------------------------------------
# These are compiled into the browser bundle at BUILD time (build args), so a
# value change requires rebuilding the frontend image.
#   - origin only, WITHOUT a trailing slash and WITHOUT /api
#   - the app appends paths itself (e.g. `${NEXT_PUBLIC_API_URL}/api/auth/login`)
#   - with nginx on port 80, use the public host, e.g.:
#       NEXT_PUBLIC_API_URL=http://ec2-1-2-3-4.compute.amazonaws.com
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SOCKET_URL=http://localhost

# ----------------------------------------------------------------------------
# General
# ----------------------------------------------------------------------------
NODE_ENV=production
